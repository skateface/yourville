---
layout: base.njk
title: null
description: null
---
<section class="hero">
  <div class="container">
    <h1>Find your town.</h1>
    <p class="lede">Yourville is a field guide to small towns and villages — which ones are worth knowing about, who they're actually good for, and how to tell if one of them might be yours.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/quiz/">Take the town quiz</a>
      <a class="btn btn-secondary" href="/guides/">Browse the guides</a>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-heading">
      <h2>Eight kinds of small town</h2>
      <a href="/guides/">All guides →</a>
    </div>
    <div class="card-grid">
      {% for a in archetypes %}
      <a class="card" href="{{ a.guide }}">
        <span class="emoji">{{ a.emoji }}</span>
        <h3>{{ a.name }}</h3>
        <p class="tagline">{{ a.tagline }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section style="background: var(--sage-light);">
  <div class="container" style="text-align:center;">
    <h2>Not sure which one is you?</h2>
    <p class="lede" style="margin-left:auto;margin-right:auto;">Answer six quick questions and we'll match you to a town archetype — then show you real towns like it.</p>
    <a class="btn btn-primary" href="/quiz/">Take the quiz →</a>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-heading">
      <h2>From the journal</h2>
      <a href="/journal/">All posts →</a>
    </div>
    <div>
      {% for post in collections.journal | limit(3) %}
      <div class="journal-item">
        <time>{{ post.data.date | readableDate }}</time>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
